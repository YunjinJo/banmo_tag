{
  "name": "banmo_tag",
  "version": "0.0.0-dev",
  "private": true,
  "description": "개발 도구 전용 (정적 검사, ESLint, Playwright E2E). 확장 프로그램 버전은 extension/manifest.json 이 기준입니다.",
  "license": "UNLICENSED",
  "scripts": {
    "validate": "node scripts/validate.js",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir extension --no-input",
    "test": "playwright test",
    "check": "npm run validate && npm run lint && npm run lint:firefox && npm test",
    "bump": "node scripts/bump-version.js",
    "test:firefox": "node tests/firefox/firefox-check.js",
    "firefox:login": "node tests/firefox/live-bridge.js --login",
    "firefox:live": "node tests/firefox/live-bridge.js",
    "firefox:run": "node tests/firefox/live.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "puppeteer-core": "25.16.0",
    "web-ext": "10.8.0"
  }
}
