{
  "manifest_version": 3,
  "name": "banmo tag",
  "version": "1.9.1",
  "description": "X(Twitter) 타임라인에서 리스트 멤버를 뱃지로 강조 표시합니다.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "banmo tag 설정",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": [
        "shared/base.js",
        "shared/list-names.js",
        "shared/list-data.js",
        "shared/list-page.js",
        "shared/badges.js",
        "shared/backup.js",
        "shared/health.js",
        "shared/ui.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
