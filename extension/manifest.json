{
  "manifest_version": 3,
  "name": "banmo_tag",
  "version": "1.7.0",
  "description": "X(Twitter) 타임라인에서 리스트 멤버를 뱃지로 강조 표시합니다.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "banmo_tag 설정",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "banmo_tag@yunjinjo",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
